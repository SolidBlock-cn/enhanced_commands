{
  "schemaVersion": 1,
  "id": "enhanced_commands",
  "version": "${version}",

  "name": "enhanced_commands",
  "description": "",
  "authors": ["SolidBlock"],
  "contact": {},

  "license": "MIT",
  "icon": "assets/enhanced_commands/icon.png",

  "environment": "*",
  "entrypoints": {
    "client": [
      "pers.solid.ecmd.EnhancedCommandsClient"
    ],
    "main": [
      "pers.solid.ecmd.EnhancedCommands"
    ],
    "fabric-datagen": [
      "pers.solid.ecmd.data.EnhancedCommandsDataGenerator"
    ]
  },

  "mixins": [
    "enhanced_commands.mixins.accessor.json",
    "enhanced_commands.mixins.impl.json",
    "enhanced_commands.mixins.mixin.json"
  ],

  "depends": {
    "fabricloader": "*",
    "fabric-api": "*",
    "minecraft": "~1.21.1"
  },

  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/class_5250": [
        "pers/solid/ecmd/mixins/ext/MutableTextExtension"
      ],
      "net/minecraft/class_2168": [
        "pers/solid/ecmd/mixins/ext/ServerCommandSourceExtension"
      ],
      "com/mojang/brigadier/exceptions/CommandSyntaxException": [
        "pers/solid/ecmd/mixins/ext/CommandSyntaxExceptionExtension"
      ],
      "net/minecraft/class_2300": [
        "pers/solid/ecmd/mixins/ext/EntitySelectorExtension"
      ],
      "net/minecraft/class_2303": [
        "pers/solid/ecmd/mixins/ext/EntitySelectorReaderExtension"
      ],
      "net/minecraft/class_1657": [
        "pers/solid/ecmd/mixins/ext/PlayerEntityExtension"
      ],
      "net/minecraft/class_3222": [
        "pers/solid/ecmd/mixins/ext/ServerPlayerEntityExtension"
      ]
    }
  }
}
